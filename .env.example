# Copy this file to .env and fill only the providers used by run_config.json.

# OpenAI roles, for example GPT_4_o_2024_05_13.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ToolSandbox search scenarios.
RAPID_API_KEY=

# Anthropic roles, for example Claude_3_Haiku.
ANTHROPIC_API_KEY=

# Batch/script defaults. These are optional.
DYNSTEER_RUNS_DIR=runs
DYNSTEER_RESULTS_DIR=results
DYNSTEER_ENV_FILE=.env
