# Copy this file to .env and fill only the providers used by run_configs.json.

# OpenAI LLM Settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic LLM Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Rapid Settings.
RAPID_API_KEY=

# ToolSandbox Agent/User Settings.
DYNSTEER_AGENT_API_KEY=
DYNSTEER_AGENT_BASE_URL=
DYNSTEER_USER_API_KEY=
DYNSTEER_USER_BASE_URL=

# Directory Settings
DYNSTEER_RUNS_DIR=runs
DYNSTEER_RESULTS_DIR=results
DYNSTEER_ENV_FILE=.env

# Judge Settings
DYNSTEER_JUDGE_API_KEY=
DYNSTEER_JUDGE_BASE_URL=

# Evaluation Settings
DYNSTEER_READY_FRONTIER_PATIENCE=24
